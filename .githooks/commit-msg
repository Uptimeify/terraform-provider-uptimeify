#!/bin/sh
# Keine KI-Zuschreibung in Commits (Co-Author, Sitzungslink, "Generated with").
# Aktivieren: git config core.hooksPath .githooks
if grep -qiE '^(co-authored-by:|claude-session:)|generated with.*claude' "$1"; then
  echo "commit-msg: KI-Zuschreibung (Co-Authored-By / Claude-Session / Generated with) ist hier nicht erlaubt." >&2
  exit 1
fi
